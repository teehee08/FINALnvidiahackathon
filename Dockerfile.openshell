FROM python:3.12-slim

WORKDIR /opt/tailored

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && playwright install --with-deps chromium

COPY . .

RUN useradd --create-home --shell /bin/sh tailored \
    && chown -R tailored:tailored /opt/tailored

USER tailored

ENV TAILORED_HOST=0.0.0.0
ENV TAILORED_PORT=8547

EXPOSE 8547

CMD ["python", "run.py"]